# Copy this to .env for local dev, or set these as real environment
# variables / secrets in whatever host you deploy to (Hugging Face Spaces
# secrets, systemd EnvironmentFile, etc.). Nothing in the codebase reads
# a URL or secret from anywhere else.

# --- Secrets ---
EDITH_JWT_SECRET=change-this-to-a-long-random-string
EDITH_SEED_ADMIN_USER=admin
EDITH_SEED_ADMIN_PASSWORD=change-me-immediately

# --- Database ---
# Local dev default (no setup needed):
DATABASE_URL=sqlite:///./edith.db
# Hosted Postgres example (Supabase/Neon/Railway) — uncomment and fill in:
# DATABASE_URL=postgresql://user:password@host:5432/edith

# --- CORS ---
# Comma-separated. Example once your React app and Flutter web build are deployed:
# EDITH_ALLOWED_ORIGINS=https://edith-dashboard.vercel.app,https://edith-spotter-web.vercel.app
EDITH_ALLOWED_ORIGINS=*

# --- Face matching tuning ---
EDITH_FACE_MODEL=ArcFace
EDITH_FACE_DETECTOR=opencv
EDITH_THRESHOLD_POSSIBLE=0.68
EDITH_THRESHOLD_LIKELY=0.82
EDITH_THRESHOLD_HIGH=0.91

# Encrypts face embeddings at rest. Generate your own:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EDITH_ENCRYPTION_KEY=K829sAcL1ZfvlBbkzpdKk6aw3qIRB6DVVlc7sZPy_80=

# "development" (default) never blocks startup. Set to "production" for
# any real deployment.
EDITH_ENVIRONMENT=development
