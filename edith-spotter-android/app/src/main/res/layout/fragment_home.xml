<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/base"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="@color/cyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- Radar sweep visual centerpiece, with status overlaid via FrameLayout -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="20dp">

            <com.edith.spotter.RadarSweepView
                android:id="@+id/radarView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/spottingStateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    android:textColor="@color/text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/cameraFacingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="@string/using_back_camera"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/toggleButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="@string/start_spotting"
                android:textStyle="bold"
                android:textColor="@color/base"
                android:backgroundTint="@color/cyan" />

            <Button
                android:id="@+id/switchCameraButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:backgroundTint="@color/panel2"
                app:icon="@drawable/ic_camera_switch"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                android:contentDescription="@string/switch_camera"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/status_idle"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="20dp"
            android:background="@color/line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_server_url"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@color/panel"
            android:hint="@string/hint_server_url"
            android:textColorHint="@color/text_mute"
            android:textColor="@color/text"
            android:inputType="textUri"
            android:padding="12dp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_device_name"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:letterSpacing="0.05" />

        <EditText
            android:id="@+id/deviceUuidInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:background="@color/panel"
            android:hint="@string/hint_device_name"
            android:textColorHint="@color/text_mute"
            android:textColor="@color/text"
            android:padding="12dp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/testConnectionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/test_connection"
            android:textColor="@color/cyan"
            android:backgroundTint="@color/panel" />

        <TextView
            android:id="@+id/connectionResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
